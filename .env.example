# ==========================================
# 📄 Izi Factures — Variables d'Environnement
# ==========================================

# 1. URL de votre projet Supabase (Dashboard -> Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet-id.supabase.co

# 2. Clé publique Anonyme Supabase (Dashboard -> Settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Clé secrète Service Role (Optionnel - Pour opérations backend avancées)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
